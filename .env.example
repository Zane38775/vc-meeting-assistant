# Copy to .env locally. Never share credentials in chat or commit them.
HOST=127.0.0.1
PORT=4318
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
ASR_PROVIDER=local
# Bundled in the desktop app; for source development default is models/local-asr.
ASR_MODEL_DIR=
# Default: X-ASR when bundled, otherwise the legacy model. Explicit fallback:
# ASR_MODEL_PROFILE=zipformer-small
# Explicit new profile: ASR_MODEL_PROFILE=xasr-480
# Optional cloud adapter only when ASR_PROVIDER=tencent:
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_ENGINE_MODEL=16k_zh_en_speaker_2.0
# For a shared HTTPS deployment, set PUBLIC_ORIGIN and COOKIE_SECURE=true.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
# Coaching rounds during live recording are spaced at least 30 seconds apart.
AI_MIN_INTERVAL_MS=30000
AI_MAX_CALLS_PER_MEETING=150
